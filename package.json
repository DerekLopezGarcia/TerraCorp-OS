{
  "name": "terracorp-os",
  "version": "0.3.2",
  "private": true,
  "description": "TerraCorp OS: industrial desktop operating system for OpenComputers in the Supersymmetry modpack",
  "license": "MIT",
  "scripts": {
    "check": "node tools/harness/check.js",
    "manifest": "node tools/make-manifest.js",
    "sim": "node tools/harness/simulate.js all",
    "sim:oc": "node tools/harness/simulate-oc.js",
    "sim:dashboard": "node tools/harness/simulate.js dashboard",
    "sim:desktop": "node tools/harness/simulate.js desktop",
    "sim:icon-order": "node tools/harness/simulate.js icon_order",
    "sim:icon-slot": "node tools/harness/simulate.js icon_slot",
    "sim:icon-update": "node tools/harness/simulate.js icon_update",
    "sim:console": "node tools/harness/simulate.js console",
    "sim:files": "node tools/harness/simulate.js files",
    "sim:settings": "node tools/harness/simulate.js settings",
    "sim:notes": "node tools/harness/simulate.js notes",
    "sim:nodes": "node tools/harness/simulate.js nodes",
    "test:notes": "node tools/harness/simulate.js notes --strict",
    "test:nodes": "node tools/harness/simulate.js nodes --strict",
    "test:cluster": "node tools/harness/test-cluster.js",
    "test:desktop": "node tools/harness/simulate.js desktop --strict",
