    "measure": "node tools/harness/measure.js",
    "test:fetch": "node tools/harness/test-fetch.js",
    "test:updater": "node tools/harness/simulate.js updater --strict",
    "test:updater-legacy": "node tools/harness/simulate.js updater_legacy --strict",
    "test:updater-rollback": "node tools/harness/simulate.js updater_rollback --strict",
    "test:updater-recover": "node tools/harness/simulate.js updater_recover --strict",
    "test:boot-update": "node tools/harness/simulate.js boot_update --strict",
