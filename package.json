{
  "name": "terracorp-os",
  "version": "0.1.4",
  "private": true,
  "description": "TerraCorp OS: industrial desktop operating system for OpenComputers in the Supersymmetry modpack",
  "license": "MIT",
  "scripts": {
    "check": "node tools/harness/check.js",
    "manifest": "node tools/make-manifest.js",
    "sim": "node tools/harness/simulate.js all",
    "sim:oc": "node tools/harness/simulate-oc.js",
    "sim:dashboard": "node tools/harness/simulate.js dashboard",
    "sim:console": "node tools/harness/simulate.js console",
    "sim:files": "node tools/harness/simulate.js files",
    "sim:settings": "node tools/harness/simulate.js settings",
    "test:install": "node tools/harness/test-install.js",
    "test:boot": "node tools/harness/test-boot.js",
    "test:faults": "node tools/harness/test-faults.js",
    "test:screens": "node tools/harness/test-screens.js",
    "measure": "node tools/harness/measure.js",
    "test:fetch": "node tools/harness/test-fetch.js",
    "test:updater": "node tools/harness/simulate.js updater --strict",
    "test:updater-rollback": "node tools/harness/simulate.js updater_rollback --strict",
    "test:dashboard-tick": "node tools/harness/simulate.js dashboard_tick --strict",
    "test:refresh-rate": "node tools/harness/simulate.js refresh_rate --strict"
  },
  "devDependencies": {
    "fengari": "^0.1.4"
  }
}
